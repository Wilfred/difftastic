+/// Does this capture name from a highlights query correspond to
+/// something we highlight as a type?
+fn is_type_capture(name: &str) -> bool {
+    name == "type"
+        || name.starts_with("type.")
+        || name.starts_with("storage.type.")
+        || name.starts_with("keyword.type.")
+        || name == "tag"
+        || name == "constructor"
+        // Rust uses 'label' for lifetimes, and highlighting
+        // lifetimes consistently with types seems reasonable.
+        || name == "label"
+}
+
+/// Does this capture name from a highlights query correspond to
+/// something we highlight as a keyword?
+fn is_keyword_capture(name: &str) -> bool {
+    name == "keyword"
+        || name.starts_with("keyword.")
+        || name == "constant"
+        || name.starts_with("constant.")
+        || name == "operator"
+        || name == "repeat"
+        || name == "conditional"
+        || name == "boolean"
+        || name == "exception"
+        || name == "include"
+}
+
+/// Does this capture name from a highlights query correspond to
+/// something we highlight as a string?
+fn is_string_capture(name: &str) -> bool {
+    name == "string"
+        || name.starts_with("string.")
+        || name == "character"
+        || name.starts_with("character.")
+}
+
+/// Does this capture name from a highlights query correspond to
+/// something we highlight as a comment?
+fn is_comment_capture(name: &str) -> bool {
+    name == "comment" || name.starts_with("comment.")
+}
+
+/// Do we do anything with this capture name from a highlights query?
+fn is_used_capture(name: &str) -> bool {
+    is_type_capture(name)
+        || is_keyword_capture(name)
+        || is_string_capture(name)
+        || is_comment_capture(name)
+}
+
+/// Skip whitespace and `;` comments in a tree-sitter query, starting
+/// at byte offset `i`.
+fn skip_query_trivia(bytes: &[u8], mut i: usize) -> usize {
+    loop {
+        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        if i < bytes.len() && bytes[i] == b';' {
+            while i < bytes.len() && bytes[i] != b'\n' {
+                i += 1;
+            }
+        } else {
+            return i;
+        }
+    }
+}
+
+/// Skip a double-quoted string in a tree-sitter query. `bytes[i]`
+/// must be the opening quote.
+fn skip_query_string(bytes: &[u8], mut i: usize) -> usize {
+    i += 1;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'\\' => i += 2,
+            b'"' => return i + 1,
+            _ => i += 1,
+        }
+    }
+    i
+}
+
+/// Does this single top-level query pattern mention any capture name
+/// that we use?
+fn pattern_has_used_capture(pattern: &str) -> bool {
+    let bytes = pattern.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'"' => i = skip_query_string(bytes, i),
+            b';' => {
+                while i < bytes.len() && bytes[i] != b'\n' {
+                    i += 1;
+                }
+            }
+            b'@' => {
+                let start = i + 1;
+                let mut end = start;
+                while end < bytes.len()
+                    && (bytes[end].is_ascii_alphanumeric() || matches!(bytes[end], b'_' | b'.'))
+                {
+                    end += 1;
+                }
+                if is_used_capture(&pattern[start..end]) {
+                    return true;
+                }
+                i = end;
+            }
+            _ => i += 1,
+        }
+    }
+    false
+}
+
+/// Return only the top-level patterns of the highlights query
+/// `query_src` that contain at least one capture we use.
+///
+/// Constructing a tree-sitter query spends substantial time on
+/// pattern analysis, and stock highlights queries are dominated by
+/// captures we never look at (e.g. @function, @variable,
+/// @punctuation). Dropping those patterns before construction makes
+/// query construction and query matching substantially cheaper, and
+/// cannot change highlighting results: tree-sitter query patterns
+/// match independently, and we only union the matches of the capture
+/// names we use.
+fn filter_highlight_query(query_src: &str) -> String {
+    let bytes = query_src.as_bytes();
+    let len = bytes.len();
+    let mut kept = String::with_capacity(query_src.len());
+
+    let mut i = 0;
+    loop {
+        i = skip_query_trivia(bytes, i);
+        if i >= len {
+            break;
+        }
+        let start = i;
+
+        // Consume one pattern: a parenthesised expression, a
+        // bracketed alternation, a quoted anonymous node, or a bare
+        // token such as the `_` wildcard.
+        match bytes[i] {
+            b'(' | b'[' => {
+                let mut depth = 0usize;
+                while i < len {
+                    match bytes[i] {
+                        b'(' | b'[' => {
+                            depth += 1;
+                            i += 1;
+                        }
+                        b')' | b']' => {
+                            depth -= 1;
+                            i += 1;
+                            if depth == 0 {
+                                break;
+                            }
+                        }
+                        b'"' => i = skip_query_string(bytes, i),
+                        b';' => {
+                            while i < len && bytes[i] != b'\n' {
+                                i += 1;
+                            }
+                        }
+                        _ => i += 1,
+                    }
+                }
+            }
+            b'"' => i = skip_query_string(bytes, i),
+            _ => {
+                while i < len
+                    && !bytes[i].is_ascii_whitespace()
+                    && !matches!(bytes[i], b'(' | b'[' | b')' | b']' | b'"' | b';' | b'@')
+                {
+                    i += 1;
+                }
+            }
+        }
+
+        // Consume any captures and quantifiers that apply to this
+        // pattern.
+        loop {
+            let j = skip_query_trivia(bytes, i);
+            if j >= len {
+                break;
+            }
+            match bytes[j] {
+                b'@' => {
+                    i = j + 1;
+                    while i < len
+                        && (bytes[i].is_ascii_alphanumeric() || matches!(bytes[i], b'_' | b'.'))
+                    {
+                        i += 1;
+                    }
+                }
+                b'?' | b'*' | b'+' => i = j + 1,
+                _ => break,
+            }
+        }
+
+        let pattern = &query_src[start..i];
+        if pattern_has_used_capture(pattern) {
+            kept.push_str(pattern);
+            kept.push('\n');
+        }
+    }
+
+    kept
+}
