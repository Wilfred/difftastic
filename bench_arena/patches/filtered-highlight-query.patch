+        assert!(filtered.contains("@keyword"));
+        assert!(filtered.contains("@operator"));
+        assert!(filtered.contains("@string"));
+        assert!(filtered.contains("@label"));
+
+        assert!(!filtered.contains("@variable"));
+        assert!(!filtered.contains("@function.macro"));
+        assert!(!filtered.contains("; a comment"));
