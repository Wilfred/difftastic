+    #[test]
+    fn test_filter_highlight_query() {
+        let src = r#"
+; a comment mentioning @keyword should be ignored
+(identifier) @variable
+
+"fn" @keyword
+
+[
+  "+"
+  "-"
+] @operator
+
+((macro_invocation
+  macro: (identifier) @function.macro))
+
